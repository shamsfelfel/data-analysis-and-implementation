%% alt: مخطط انسيابي لاختيار ردّ الفعل على رمز الحالة. 2xx أو 3xx: اقرأ جسم JSON وتتبع المكتبة إعادة التوجيه. بقية رموز 4xx مثل 400 و401 و403 و404: أصلح المفتاح أو الصلاحية أو الطلب ولا تعد المحاولة. 429 أو 5xx: انتظر المدة في Retry-After أو تباطأ 2 ثم 4 ثم 8 ثوانٍ ثم اسأل: هل بقيت محاولات؟ فإن بقيت فاسأل ثانية وإلا فاستسلم وارفع خطأً.
flowchart TD
  S{"ما رمز الحالة<br/>في الردّ؟"}
  S -- "2xx أو 3xx" --> OK["اقرأ جسم JSON<br/>(تتبع المكتبة<br/>إعادة التوجيه عنك)"]
  S -- "بقية 4xx<br/>400 و401 و403 و404" --> FIX["أصلح المفتاح أو<br/>الصلاحية أو الطلب<br/>ولا تعد المحاولة"]
  S -- "429 أو 5xx" --> WAIT["انتظر: Retry-After<br/>أو تباطأ 2 و4 و8 ث"]
  WAIT --> LIM{"بقيت محاولات؟"}
  LIM -- "نعم" --> S
  LIM -- "لا" --> GIVE["استسلم<br/>وارفع خطأً"]
