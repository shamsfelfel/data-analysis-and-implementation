%% alt: مخطط انسيابي لآليات الفقد الثلاث في ملف الإيجارات. يبدأ بسؤال واحد: هل يعتمد كون الخلية فارغة على شيء؟ فإن لم يعتمد على شيء فالآلية فقد عشوائي تامّ (MCAR)، ومثالها area_m2 بسبعة وعشرين فراغًا موزّعة بانتظام، ووسيط المجموعة آمن. وإن اعتمد على عمود تراه فالآلية فقد عشوائي مشروط (MAR)، ومثالها deposit بمئة وثلاثة وعشرين فراغًا منها مئة وثلاثة لوكالتين، والقاعدة لكل مجموعة هي الجواب الصحيح. وإن اعتمد على القيمة المخفيّة نفسها فالآلية فقد غير عشوائي (MNAR)، ومثالها monthly_rent بتسعة عشر فراغًا على أغلى الشقق، ولا تعويض يستعيدها، فاحذف الصف وارجع إلى المصدر. وتقول ملاحظة أخيرة إن الثلاث لا تُفرَّق إلا بمعرفة كيف جُمعت البيانات، لا من الملف وحده.
flowchart TD
  S(["عمود فيه فراغات"]) --> Q{"هل يعتمد كونه فارغًا<br/>على شيء؟"}
  Q -- "على لا شيء نجده" --> M1["فقد عشوائي تامّ<br/>MCAR"]
  Q -- "على عمود تراه" --> M2["فقد عشوائي مشروط<br/>MAR"]
  Q -- "على القيمة المخفيّة" --> M3["فقد غير عشوائي<br/>MNAR"]
  M1 --> E1["`area_m2`: ‏27 فراغًا<br/>لا نمط بحسب وكالة أو مدينة"]
  M2 --> E2["`deposit`: ‏123 فراغًا<br/>‏103 منها وكالتان"]
  M3 --> E3["`monthly_rent`: ‏19 فراغًا<br/>السعر عند الطلب = غالٍ"]
  E1 --> D1["عبّئ من وسيط مجموعة<br/>وارفع عَلَمًا"]
  E2 --> D2["اضبط قاعدة لكل مجموعة<br/>مع بديل"]
  E3 --> D3["احذف الصف<br/>واسأل المصدر"]
  D1 --> W["الملف لا يُثبت<br/>أيّها أنت فيها"]
  D2 --> W
  D3 --> W
