%% alt: شجرة قرار تختار مُرمِّزًا لعمود واحد انطلاقًا من مستوى قياسه. والسؤال الأول هو مستوى القياس الذي كُتب في الدرس 2 من النظري 1. فإن كان العمود معرّفًا فأخرِجه من مصفوفة الخصائص، لأنه يسمّي صفًّا واحدًا ولا يعمّم. وإن كان اسميًّا فاسأل كم فئةً فيه: فإلى نحو خمس عشرة فئة رمّزه ترميزًا أحاديًّا على قائمة فئات مضبوطة؛ وإن زاد على ذلك فاجمع المستويات النادرة في دلو Other، أو استعمل ترميزًا بالتكرار، ولا تمدّ يدك إلى الترميز بالهدف إلا خارج الطيّة وإلا إذا قال القياس إنه يُفيد. وإن كان ترتيبيًّا فحوّل الترتيب المعلَن إلى رموز صحيحة بنوع CategoricalDtype مرتَّب صريح، لا بـ cat.codes على فئة غير مرتَّبة، لأن ذلك يرقّم المستويات أبجديًّا. وإن كان فتريًّا أو نسبيًّا فأبقِ الرقم ووحّد مقياسه، واختر بين الحدَّين والتوحيد المعياري والتوحيد الحصين بحسب شكل العمود. وكل فرع ينتهي إلى الموضع نفسه: فقائمة الفئات وخريطة الرموز ووسائط المُقايِس تُضبط على صفوف التدريب وحدها، وتُحفظ في قاموس الوسائط المضبوطة، وتُطبَّق دون تغيير على ملف الشهر القادم، حيث تُعَدّ القيمة الخارجة عن القائمة المضبوطة ويُبلَّغ عنها لا تُصفَّر بصمت.
flowchart TD
  S(["عمود واحد"]) --> Q1{"مستوى القياس؟<br/>(ن1 د2)"}
  Q1 -- "معرّف" --> ID["أخرِجه.<br/>إنه يسمّي صفًّا واحدًا."]
  Q1 -- "اسمي" --> Q2{"كم عدد<br/>الفئات؟"}
  Q1 -- "ترتيبي" --> ORD["الترتيب المعلَن إلى رموز<br/>بـ `CategoricalDtype` مرتَّب"]
  Q1 -- "فتري / نسبي" --> NUM{"ما شكل<br/>العمود؟"}
  Q2 -- "حتى ~15" --> OH["ترميز أحادي على<br/>قائمة فئات مضبوطة"]
  Q2 -- "تعدّد عالٍ" --> HC["النادر إلى `Other`،<br/>أو ترميز بالتكرار"]
  HC -.-> TE["الترميز بالهدف:<br/>خارج الطيّة أو لا شيء"]
  ORD --> WARN["لا تستعمل `cat.codes`<br/>على فئة غير مرتَّبة"]
  NUM -- "محدود ولا شواذ" --> MM["الحدّان إلى [0، 1]"]
  NUM -- "متناظر تقريبًا" --> ZS["توحيد معياري:<br/>متوسط 0 وانحراف 1"]
  NUM -- "ملتوٍ أو ثقيل الذيل" --> RB["حصين: الوسيط والمدى الربيعي"]
  OH --> F[["`fitted`: قوائم الفئات<br/>وخرائط الرموز ووسائط المُقايِس"]]
  HC --> F
  TE --> F
  WARN --> F
  MM --> F
  ZS --> F
  RB --> F
  ID --> F
  F --> A["طبّقها دون تغيير على حزيران.<br/>القيم غير المرئية تُعَدّ لا تُصفَّر."]
