  SH --> VA["**تحقّق** 96 صفًّا"]
  SH --> TE["**اختبار** 96 صفًّا"]
  TR -- "اضبط هنا، مرات كثيرة" --> P["الوسائط المضبوطة:<br/>الوسيط، السياج، قوائم الفئات،<br/>حدود النطاقات، المقياس"]
  P --> VA
  VA -- "اقرأ كثيرًا، ولا تضبط عليها" --> CH{"قارن الوصفات<br/>واختر واحدة"}
  CH -. "غيّر الوصفة" .-> TR
  CH -- "الوصفة المختارة وحدها" --> G{{"بوابة:<br/>اقرأ مرة واحدة في النهاية"}}
  G --> TE
  TE --> N[["الرقم الذي تُبلّغ عنه"]]
  W["النتيجة التي حسّنت مقابلها<br/>نتيجةُ تدريب متنكّرة"] -.-> CH
