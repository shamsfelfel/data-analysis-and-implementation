%% alt: مخطط انسيابي للترتيب القياسي للتحويل. يُحمَّل الملف الخام ويُضبط نوعه، ثم يُنسَخ حتى لا يُكتَب في الجدول الخام أبدًا. وتتوالى خمس مراحل بالترتيب: البنية (التكرارات وإعادات النشر ومعنى الصف الواحد)، والقيم (النصوص والقيم المنطقية والتواريخ والأرقام المستحيلة)، والمفقود (العدّ وتسمية الآلية ثم الحذف أو التعويض أو التعليم)، والقيم الشاذة (قاعدة وحدّ، والتعليم قبل الحذف)، والترميز وتوحيد المقاييس (الفئات إلى أرقام والأرقام إلى مدى واحد). وكل مرحلة تعيد جدولًا وسطرَ سجل، وتُخزَّن الوسائط المضبوطة لمراحل المفقود والشاذ والترميز حتى يُطبَّق الخط نفسه على ملف الشهر القادم دون إعادة ضبط.
flowchart TD
  R["الملف الخام<br/>لا يُكتَب فيه أبدًا"] --> L["التحميل وضبط الأنواع<br/>مخطط وتحقّق"]
  L --> C["`copy()`<br/>اعمل على نسخة"]
  C --> S1["1 البنية<br/>التكرارات وإعادات النشر<br/>ما هو الصف الواحد؟"]
  S1 --> S2["2 القيم<br/>نصوص ومنطقية وتواريخ<br/>وأرقام مستحيلة"]
  S2 --> S3["3 المفقود<br/>عُدّ، وسمِّ الآلية<br/>احذف أو عوِّض أو علِّم"]
  S3 --> S4["4 القيم الشاذة<br/>اختر قاعدة<br/>علِّم قبل أن تحذف"]
  S4 --> S5["5 الترميز وتوحيد المقاييس<br/>الفئات إلى أرقام<br/>والأرقام إلى مدى واحد"]
  S5 --> M["جدول جاهز للنموذج<br/>+ سجل القرارات"]
  S3 -.-> P[["الوسائط المضبوطة<br/>وسطاء وقوائم وحدّان"]]
  S4 -.-> P
  S5 -.-> P
  P -.-> N["ملف الشهر القادم<br/>طبّق ولا تُعِد الضبط"]
