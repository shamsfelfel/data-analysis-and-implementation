  Q1 -- "لا" --> Q2{"كم نسبة<br/>الفراغ؟"}
  Q2 -- "كله تقريبًا" --> C["احذف العمود<br/>واذكر ثمن ذلك"]
  Q2 -- "بعضه" --> Q3{"أي آلية؟"}
  Q3 -- "MNAR" --> A3["احذف الصفوف، أو انمذج<br/>الثقب واقعةً بذاته"]
  Q3 -- "MAR" --> A2["قاعدة لكل مجموعة<br/>مع بديل للمجموعة الخالية"]
  Q3 -- "MCAR" --> A1["وسيط مجموعة،<br/>أو عامّ إن قلّت الفراغات"]
  A1 --> F["أضِف عَلَم فقد"]
